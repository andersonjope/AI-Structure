{
  "permissions": {
    "allow": [
      "Bash(mvn test:*)",
      "Bash(mvn clean test:*)",
      "Bash(mvn verify:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(./mvnw test:*)",
      "Bash(./mvnw verify:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm --filter:*)",
      "Bash(docker compose config:*)",
      "Bash(bash scripts/validate-ai-structure.sh:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(docker system prune:*)",
      "Bash(kubectl delete:*)",
      "Bash(terraform destroy:*)"
    ]
  }
}
