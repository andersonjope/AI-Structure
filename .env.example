# Exemplo de variáveis para desenvolvimento local. Copiar para .env (nunca versionado):
#   cp .env.example .env
# Manter este arquivo e docs/env/README.md sincronizados com toda variável nova.
# Valores vazios são obrigatórios a preencher; nunca versionar valor real.

# --- Globais ---
APP_ENV=local
# Token compartilhado entre gateway e serviços internos. Forte e diferente por ambiente.
INTERNAL_GATEWAY_TOKEN=

# --- MongoDB (uma URI por serviço; usuário com menor privilégio) ---
IDENTITY_MONGODB_URI=mongodb://localhost:27017/identity
COMPANY_MONGODB_URI=mongodb://localhost:27017/company
CLIENT_MONGODB_URI=mongodb://localhost:27017/client
CATALOG_MONGODB_URI=mongodb://localhost:27017/catalog
ORDER_MONGODB_URI=mongodb://localhost:27017/order
SCHEDULING_MONGODB_URI=mongodb://localhost:27017/scheduling

# --- API Gateway ---
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_URL=http://localhost:8081
COMPANY_SERVICE_URL=http://localhost:8082
CLIENT_SERVICE_URL=http://localhost:8083
CATALOG_SERVICE_URL=http://localhost:8084
ORDER_SERVICE_URL=http://localhost:8085
EMAIL_SERVICE_URL=http://localhost:8086
SCHEDULING_SERVICE_URL=http://localhost:8087

# --- Tokens entre serviços (um por par de serviços) ---
SCHEDULING_CLIENT_SERVICE_TOKEN=
SCHEDULING_ORDER_SERVICE_TOKEN=

# --- E-mail (SMTP local, ex.: MailHog na 1025) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@example.local

# --- Frontend ---
MOBILE_API_BASE_URL=http://localhost:8080/api/v1
