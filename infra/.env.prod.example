# Modelo do .env de produção. O deploy copia este arquivo para a VPS; o .env real é criado
# na primeira execução, preenchido à mão (chmod 600) e NUNCA versionado nem editado pelo
# deploy. Todo valor PREENCHER faz o deploy falhar até ser trocado.
# IMAGE_REGISTRY e IMAGE_TAG não ficam aqui: o deploy os injeta por execução.

APP_ENV=production

# Segredos fortes, exclusivos de produção.
INTERNAL_GATEWAY_TOKEN=PREENCHER

# MongoDB externo: host é o nome do container do banco na rede de dados e a porta é a interna.
IDENTITY_MONGODB_URI=PREENCHER
